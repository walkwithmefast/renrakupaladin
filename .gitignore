node_modules/
tmp/
__pycache__/
tools/blurbs.json
tools/drugs.json
# the user's own saved characters, personal - not something to publish
characters/
# rulebook PDF-derived caches (descriptions/edits), created next to characters/ at runtime
rulebook/
# the Impeccable design skill's local cache/state
.impeccable/

# dist/ is regenerated by `node build.mjs` (app.js/app.css/index.html/sheetTemplate.js) or by
# `python tools/build_data.py` (blurbs.js, from the user's own copyrighted PDFs - never publish it).
# data.js/books.js are the exception: GPL-3.0 Chummer5a-derived data and PDF file/page metadata with no
# prose (see PROJECT_STATUS.md's "Distributing a copy to someone else") - prebuilt and committed so the app
# runs right after a clone, without needing the Chummer5a install + PDFs that rebuilding them needs.
dist/*
!dist/data.js
!dist/books.js

# personal handoff log - local only
PROJECT_STATUS.md
